{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jio.ai/contracts/mcp-app-external/app_instance_envelope.public.schema.json",
  "title": "JIO external MCP app instance envelope",
  "description": "Public, self-contained schema for the JIO host-facing app result envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance_id", "result_kind", "app_id", "state"],
  "properties": {
    "instance_id": { "type": "string", "minLength": 1 },
    "result_kind": { "const": "app_instance" },
    "app_id": { "type": "string", "minLength": 1 },
    "app_version": { "type": "string", "minLength": 1 },
    "source_tool": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" },
      "default": []
    },
    "input_bindings": { "$ref": "#/$defs/input_bindings" },
    "emitted_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/emitted_artifact" },
      "default": []
    },
    "selectable_runtime_values": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectable_runtime_value" },
      "default": []
    },
    "state_kind": {
      "type": "string",
      "enum": ["template", "session", "resolved"]
    },
    "state_schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "artifact_type": {
      "type": "string",
      "enum": ["rows", "text", "chart_spec", "sequence", "image", "json"]
    },
    "artifact_role": {
      "type": "string",
      "enum": ["primary", "derived", "supporting"]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "$ref": "#/$defs/artifact_type" },
        "dataset": { "type": "string", "minLength": 1 },
        "source_tool": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "source_turn_id": { "type": "string", "minLength": 1 }
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" },
          "default": []
        },
        "parameters": { "type": "object", "additionalProperties": true, "default": {} },
        "controls":   { "type": "object", "additionalProperties": true, "default": {} },
        "hydration":  { "type": "object", "additionalProperties": true, "default": {} },
        "intent":     { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "emitted_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type"],
      "properties": {
        "artifact_id":   { "type": "string", "minLength": 1 },
        "artifact_type": { "$ref": "#/$defs/artifact_type" },
        "role":          { "$ref": "#/$defs/artifact_role" },
        "title":         { "type": "string", "minLength": 1 },
        "source_tool":   { "type": "string", "minLength": 1 },
        "instance_id":   { "type": "string", "minLength": 1 }
      }
    },
    "interface_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provided_value_type": { "type": ["string", "null"], "minLength": 1 },
        "source_app_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "artifact_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_type" },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "selectable_runtime_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value_type"],
      "properties": {
        "key":           { "type": "string", "minLength": 1 },
        "label":         { "type": ["string", "null"] },
        "description":   { "type": ["string", "null"] },
        "value_type":    { "type": "string", "minLength": 1 },
        "value_schema":  { "type": ["object", "null"], "additionalProperties": true },
        "required":      { "type": ["boolean", "null"] },
        "default_value": true,
        "compatibility": {
          "anyOf": [
            { "$ref": "#/$defs/interface_compatibility" },
            { "type": "null" }
          ]
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "app_name":      { "type": "string", "minLength": 1 },
        "launch_url":    { "type": "string", "minLength": 1 },
        "ui_resource":   { "$ref": "#/$defs/ui_resource" },
        "preview_image": { "type": "string", "minLength": 1 },
        "description":   { "type": "string" },
        "icon":          { "type": "string", "minLength": 1 }
      }
    },
    "ui_resource": {
      "type": "object",
      "additionalProperties": true,
      "required": ["uri"],
      "properties": {
        "uri":      { "type": "string", "minLength": 1 },
        "mime_type":{ "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "text":     { "type": "string" },
        "blob":     { "type": "string" },
        "meta":     { "type": "object", "additionalProperties": true },
        "_meta":    { "type": "object", "additionalProperties": true }
      }
    }
  }
}
