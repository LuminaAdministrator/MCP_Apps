{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://well.td.plot/schemas/state.resolved.v1.schema.json",
  "title": "TD Plot resolved state — schema version 1",
  "description": "State carried inside the JIO app envelope for a resolved (read-only) TD plot result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["well_uuid", "source_tool", "vega_lite_spec"],
  "properties": {
    "well_uuid":        { "type": "string", "minLength": 1 },
    "well_name":        { "type": "string" },
    "source_tool":      { "type": "string", "minLength": 1 },
    "vega_lite_spec":   { "type": "object" },
    "data_point_count": { "type": "integer", "minimum": 0 },
    "depth_unit":       { "type": "string" },
    "time_unit":        { "type": "string" }
  }
}
