# Data source mode: "fixture" (bundled sample data) or "external_http" (upstream service)
TD_PLOT_DATA_SOURCE_MODE=fixture

# URL for the upstream TD function data service (used when DATA_SOURCE_MODE=external_http)
TD_PLOT_DATA_SERVICE_URL=http://localhost:8001

# HTTP server bind address and port (container default is 0.0.0.0:8080)
TD_PLOT_HOST=0.0.0.0
TD_PLOT_PORT=8080
